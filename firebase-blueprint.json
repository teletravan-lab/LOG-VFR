{
  "entities": {
    "analytics": {
      "title": "analytics",
      "description": "Global analytics and logs counter",
      "type": "object",
      "properties": {
        "printCount": {
          "type": "number",
          "description": "Total logs count printed or created"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      },
      "required": ["printCount"]
    },
    "flightLog": {
      "title": "flightLog",
      "description": "Saved flight plan log with share code JJ-MM-XXXXXX",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique log identifier in format JJ-MM-XXXXXX"
        },
        "flightPlan": {
          "type": "object",
          "description": "Flight plan details"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO creation date"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO last update date"
        },
        "expiresAt": {
          "type": "object",
          "description": "Firestore Timestamp expiring in 6 months"
        }
      },
      "required": ["id", "flightPlan"]
    }
  },
  "firestore": {
    "/analytics/{analyticsId}": {
      "schema": "analytics",
      "description": "Global counters"
    },
    "/flightLogs/{logId}": {
      "schema": "flightLog",
      "description": "Stored flight plans"
    }
  }
}
