{
  "entities": {
    "analytics": {
      "title": "analytics",
      "description": "Global analytics and logs counter",
      "type": "object",
      "properties": {
        "printCount": {
          "type": "number",
          "description": "Total logs count printed or created"
        },
        "visitCount": {
          "type": "number",
          "description": "Total visits count"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      },
      "required": ["printCount"]
    },
    "dailyVisits": {
      "title": "dailyVisits",
      "description": "Daily visits counter in analytics collection",
      "type": "object",
      "properties": {
        "count": {
          "type": "number",
          "description": "Visits on this day"
        },
        "day": {
          "type": "string",
          "description": "Date AAAA-MM-JJ in Europe/Paris timezone"
        },
        "expiresAt": {
          "type": "object",
          "description": "Firestore Timestamp expiring in 90 days"
        }
      },
      "required": ["count", "day"]
    },
    "flightLog": {
      "title": "flightLog",
      "description": "Saved flight plan log with share code JJ-MM-XXXXXX",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique log identifier in format JJ-MM-XXXXXX"
        },
        "outbound": {
          "type": "object",
          "description": "Outbound flight plan details"
        },
        "return": {
          "type": "object",
          "description": "Return flight plan details or null"
        },
        "activeLeg": {
          "type": "string",
          "description": "Active leg displayed ('outbound' | 'return')"
        },
        "flightPlan": {
          "type": "object",
          "description": "Flight plan details (legacy backward compatibility)"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO creation date"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO last update date"
        },
        "expiresAt": {
          "type": "object",
          "description": "Firestore Timestamp expiring in 6 months"
        }
      },
      "required": ["id"]
    }
  },
  "firestore": {
    "/analytics/{analyticsId}": {
      "schema": "analytics",
      "description": "Global counters"
    },
    "/flightLogs/{logId}": {
      "schema": "flightLog",
      "description": "Stored flight plans"
    }
  }
}
