rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Analytics counter accessible publicly
    match /analytics/{analyticsId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Flight logs storage
    match /flightLogs/{logId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if true;
      allow delete: if false;
    }
  }
}
